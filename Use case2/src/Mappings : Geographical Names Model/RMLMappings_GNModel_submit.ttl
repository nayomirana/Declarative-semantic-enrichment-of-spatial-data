    rr:predicateObjectMap [
      rr:predicate sdo:additionalType;
      rr:objectMap [
        rr:template "https://linked.data.gov.au/def/go-categories/{feature_type}";
        ]
    ];
  
  rr:predicateObjectMap [
    rr:predicate geo:hasGeometry;
    rr:objectMap [
      rr:parentTriplesMap <#SASitesGeometryMapping>;  
