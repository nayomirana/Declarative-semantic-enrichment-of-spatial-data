    a rr:TriplesMap;
    rml:logicalSource <#QLDSitesSource>;
    rr:subjectMap [
      rr:template  "http://geosensor.net/ns/pnkg/PlaceName/{State}/{Ref number}";
      rr:class gn:GeographicalName;
    ];
    
    rr:predicateObjectMap [
      rr:predicate cn:isNameFor ;
      rr:objectMap [
        rr:template "http://geosensor.net/ns/pnkg/Place/{State}/{Ref number}";
        ]
    ];

    rr:predicateObjectMap [
        rr:predicate cn:hasCompoundedName;
        rr:objectMap [
          fnml:functionValue [
            rr:predicateObjectMap [
              rr:predicate fno:executes ;
              rr:objectMap [ rr:constant grel:string_toTitlecase ] ] ;
            rr:predicateObjectMap [
              rr:predicate grel:valueParameter ;
              rr:objectMap [ rml:reference "Place name";
              rr:language "en";
               ] ]
          ]
        ]
      ];


    # https://linked.data.gov.au/def/gn-part-types/geographicalGivenName
    rr:predicateObjectMap [
       rr:predicate sdo:additionalType;
       rr:objectMap [
            rr:constant gpt:geographicalGivenName;
        ]
    ] ;
    
    rr:predicateObjectMap [
       rr:predicate lm:hasLifeCycleStage;
        rr:objectMap [
            rr:parentTriplesMap <#QLDPlaceNameLifeCycleStageMapping> 
        ]
    ] ;

    rr:predicateObjectMap [
      rr:predicate prov:wasDerivedFrom;
      rr:objectMap [
        rr:parentTriplesMap <#PlaceNameDataMapping>;
        rr:joinCondition [
          rr:child "State"; 
          rr:parent "ShortenName";
          ]
      ]
    ].

<#QLDPlaceNameLifeCycleStageMapping> a rr:TriplesMap;
    rml:logicalSource <#QLDSitesSource>;
    
    rr:subjectMap [
       rr:template "http://geosensor.net/ns/pnkg/LifecycleStage/{Name_status}/{State}/{Ref number}";
        rr:class lm:LifecycleStage;
    ];

  rr:predicateObjectMap [
    rr:predicate sdo:additionalType ;
     rr:objectMap [
      rr:template "http://geosensor.net/ns/pnkg/stage/{Name_status}"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate time:hasTime ;
    rr:objectMap [ 
      rr:parentTriplesMap <#QLD_TimeMap> 
      ]
  ] .

<#QLD_TimeMap> a rr:TriplesMap;
    rml:logicalSource <#QLDSitesSource>;

   rr:subjectMap [
       rr:template "http://geosensor.net/ns/pnkg/Time/{State}/{Ref number}/gazetted";
       rr:class time:TemporalEntity ;
    ];

  rr:predicateObjectMap [
    rr:predicate time:hasBeginning ;
    rr:objectMap [
      rr:parentTriplesMap <#QLD_TimeStart>
    ]
  ] .

<#QLD_TimeStart> a rr:TriplesMap;
    rml:logicalSource <#QLDSitesSource>;
   rr:subjectMap [
       rr:template "http://geosensor.net/ns/pnkg/Time/Start/{State}/{Ref number}/gazetted";
       rr:class time:Instant ;
    ];

  rr:predicateObjectMap [
    rr:predicate time:inXSDDate ;
    rr:objectMap [ 
      rml:reference "Gazetted date" ; 
      rr:datatype  xsd:date]
  ] .


