@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sd:  <http://www.w3.org/ns/sparql-service-description#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sf: <http://www.opengis.net/ont/sf#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix loci: <http://linked.data.gov.au/def/loci#> .
@prefix vc: <http://www.w3.org/2006/vcard/ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix fsdf: <http://linked.data.gov.au/def/fsdf/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix grel:    <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno: <http://w3id.org/function/ontology#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix onto: <http://example.di.uoa.gr/ontology#>.
@prefix sdo: <https://schema.org/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix lm: <https://linked.data.gov.au/def/lifecycle> .
@prefix gpt: <https://linked.data.gov.au/def/gn-part-types/> .
@prefix goc: <https://linked.data.gov.au/def/go-categories/> .
@prefix gn: <https://linked.data.gov.au/def/gn/> .
@prefix cn: <https://linked.data.gov.au/def/cn/> .
@prefix pnkg: <http://geosensor.net/ns/pnkg#>.
@base <http://geosensor.net/ns/pnkg#>.

<#ACTSitesSource> a rml:LogicalSource;
    rml:source "../data/ACT/ACT2026Q1.csv";
    rml:referenceFormulation ql:CSV .

<#NTSitesSource> a rml:LogicalSource;
    rml:source "../data/NT/NT2026Q1.csv";
    rml:referenceFormulation ql:CSV .

<#WASitesSource> a rml:LogicalSource;
    rml:source "../data/WA/WA2026Q1.csv";
    rml:referenceFormulation ql:CSV .

<#QLDSitesSource> a rml:LogicalSource;
    rml:source "../data/QLD/QLD2026Q1.csv";
    rml:referenceFormulation ql:CSV .

<#TASSitesSource> a rml:LogicalSource;
    rml:source "../data/TAS/TAS2026Q1.csv";
    rml:referenceFormulation ql:CSV .

<#VICRoadsSource> a rml:LogicalSource;
    rml:source "../data/VIC/VIC_roads2026Q1.csv";
    rml:referenceFormulation ql:CSV .

<#VICSitesSource> a rml:LogicalSource;
    rml:source "../data/VIC/VIC_places2026Q1.csv";
    rml:referenceFormulation ql:CSV .

<#NSWSitesSource> a rml:LogicalSource;
    rml:source "../data/NSW/NSW2026Q1.csv";
    rml:referenceFormulation ql:CSV .

<#SASitesSource> a rml:LogicalSource;
    rml:source "../data/SA/SA_Sites2026Q1.csv";
    rml:referenceFormulation ql:CSV .

<#SAAreasSource> a rml:LogicalSource;
    rml:source "../data/SA/SA_Areas2026Q1.csv";
    rml:referenceFormulation ql:CSV .

<#SALinesSource> a rml:LogicalSource;
    rml:source "../data/SA/SA_Lines2026Q1.csv";
    rml:referenceFormulation ql:CSV.

<#PlaceNameDataSource> a rml:LogicalSource;
    rml:source "../data/MetaData/AustralianPlacenamesMetadata.csv";
    rml:referenceFormulation ql:CSV .


############ ACT #############################################################################
<#ACTGeographicalObjectMapping>
    a rr:TriplesMap;
    rml:logicalSource <#ACTSitesSource>;
    
    rr:subjectMap [
      rr:template  "http://geosensor.net/ns/pnkg/Place/{AUTHORITY}/{AUTH_ID}";
      rr:class gn:GeographicalObject, geo:Feature;
      ];
      
    rr:predicateObjectMap [
      rr:predicate sdo:name ;
      rr:objectMap [
        rr:template "http://geosensor.net/ns/pnkg/PlaceName/{AUTHORITY}/{AUTH_ID}";
        ]
    ];
    
    rr:predicateObjectMap [
      rr:predicate sdo:additionalType;
      rr:objectMap [
        rr:template "https://linked.data.gov.au/def/go-categories/{FEATURE}";
        ]
    ];
  
  rr:predicateObjectMap [
    rr:predicate geo:hasGeometry;
    rr:objectMap [
      rr:parentTriplesMap <#ACTGeometryMapping>;  
      ]
  ].
    
<#ACTGeometryMapping> a rr:TriplesMap;
   rml:logicalSource <#ACTSitesSource>;
    
   rr:subjectMap [
    rr:template "http://geosensor.net/ns/pnkg/Geometry/Point/{AUTHORITY}/{AUTH_ID}";
    rr:class geo:Geometry;
    ];
    
    rr:predicateObjectMap [
      rr:predicate geo:asWKT;
      rr:objectMap [
        rml:reference "geometry";
        rr:datatype geo:wktLiteral;
        ]
    ] .

<#ACTGeographicalNameMapping>
    a rr:TriplesMap;
    rml:logicalSource <#ACTSitesSource>;
    rr:subjectMap [
      rr:template  "http://geosensor.net/ns/pnkg/PlaceName/{AUTHORITY}/{AUTH_ID}";
      rr:class gn:GeographicalName;
    ];
    
    rr:predicateObjectMap [
      rr:predicate cn:isNameFor ;
      rr:objectMap [
        rr:template "http://geosensor.net/ns/pnkg/Place/{AUTHORITY}/{AUTH_ID}";
        ]
    ];

    rr:predicateObjectMap [
        rr:predicate cn:hasCompoundedName;
        rr:objectMap [
          fnml:functionValue [
            rr:predicateObjectMap [
              rr:predicate fno:executes ;
              rr:objectMap [ rr:constant grel:string_toTitlecase ] ] ;
            rr:predicateObjectMap [
              rr:predicate grel:valueParameter ;
              rr:objectMap [ rml:reference "NAME";
              rr:language "en";
               ] ]
          ]
        ]
      ];

    # https://linked.data.gov.au/def/gn-part-types/geographicalGivenName
    rr:predicateObjectMap [
       rr:predicate sdo:additionalType;
       rr:objectMap [
            rr:constant gpt:geographicalGivenName;
        ]
    ] ;
    
    rr:predicateObjectMap [
       rr:predicate lm:hasLifeCycleStage;
        rr:objectMap [
            rr:parentTriplesMap <#ACTPlaceNameLifeCycleStageMapping> 
        ]
    ] ;

    rr:predicateObjectMap [
      rr:predicate prov:wasDerivedFrom;
      rr:objectMap [
        rr:parentTriplesMap <#PlaceNameDataMapping>;
        rr:joinCondition [
          rr:child "AUTHORITY"; 
          rr:parent "ShortenName";
          ]
      ]
    ].

<#ACTPlaceNameLifeCycleStageMapping> a rr:TriplesMap;
    rml:logicalSource <#ACTSitesSource>;
    
    rr:subjectMap [
       rr:template "http://geosensor.net/ns/pnkg/LifecycleStage/{STATUS}/{AUTHORITY}/{AUTH_ID}";
        rr:class lm:LifecycleStage;
    ];

    rr:predicateObjectMap [
    rr:predicate sdo:additionalType ;
     rr:objectMap [
      rr:template "http://geosensor.net/ns/pnkg/stage/{STATUS}"
    ]
  ] .

