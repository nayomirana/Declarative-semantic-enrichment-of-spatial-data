############################################# RML Mappings for Geometries in Hydrospatial Datasets ##################################################
<#DVM_GeometryInstancesWB> a rr:TriplesMap;
  rml:logicalSource <#LogicalSource_WBResources>;

    rr:subjectMap [
    rr:template "http://example.org/ns/DV_Project#{dataset}_{geomtype}{OBJECTID}";
    # rml:logicalTarget <#TargetSPARQL>;
    rr:class geosparql:Geometry
  ];

  rr:predicateObjectMap [
    rr:predicate dynamicVicMapVocab:hasObjectID;
    rr:objectMap [
      rml:reference "OBJECTID";
      rr:datatype xsd:integer;
    ]
  ];

  # rr:predicateObjectMap [
  #   rr:predicate geosparql:asWKT;
  #   rr:objectMap [
  #     rml:reference "geom";
  #     rr:datatype geosparql:wktLiteral
  #   ]
  # ];

  rr:predicateObjectMap [
    rr:predicate dynamicVicMapVocab:dataset;
    rr:objectMap [
      rml:reference "dataset";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate dynamicVicMapVocab:hasGeometryType;
    rr:objectMap [
      rml:reference "geomtype";
      rr:datatype xsd:string
    ]
  ];

 rr:predicateObjectMap [
    rr:predicate dynamicVicMapVocab:createDate;
    rr:objectMap [
      fnml:functionValue [
      	rr:predicateObjectMap [
      		rr:predicate fno:executes ;
      		rr:objectMap [ rr:constant geogrel:formatDate ] ] ;
      	rr:predicateObjectMap [
      		rr:predicate geogrel:valueParameter ;
      		rr:objectMap [ rml:reference "C_DATE_PFI" ] ]
      ];
      rr:datatype xsd:Date
    ]
  ]; 

  rr:predicateObjectMap [
    rr:predicate smurf:varietyOf;
    rr:objectMap [
      rml:reference "f_type_cod";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate smurf:PFI;
    rr:objectMap [
      rml:reference "pfi";
      rr:datatype xsd:integer
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate smurf:UFI;
    rr:objectMap [
      rml:reference "ufi";
      rr:datatype xsd:integer
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate smurf:isCrown;
    rr:objectMap [
      rml:reference "isCrown";
      rr:datatype xsd:boolean
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate smurf:hasGeometryProvenance;
    rr:objectMap [
       rr:parentTriplesMap <#MetadataHydro> ; 
       rr:joinCondition [
            rr:child "dataset";
            rr:parent "Dataset";
        ]; 
    ]
  ].

######################           RML Mappings for Mapping Geometry Values in each Hydrospatial Datasets ##################
########### HY_WATER_POINT and HY_WATER_AREA_POLYGON ######################
<#DVM_GeometryInstancesWB_point_poly> a rr:TriplesMap;
  rml:logicalSource <#LogicalSource_WBResources_point_poly>;

    rr:subjectMap [
    rr:template "http://example.org/ns/DV_Project#{dataset}_{geomtype}{OBJECTID}";
    # rml:logicalTarget <#TargetSPARQL>;
    rr:class geosparql:Geometry
  ];

  rr:predicateObjectMap [
          rr:predicate geosparql:asWKT;
          rr:objectMap <#FunctionMapConvertToCRS_EPSG_4326_From_4283>
   ] ;

    rr:predicateObjectMap [
          rr:predicate dynamicVicMapVocab:geometryCRS32755;
          rr:objectMap <#FunctionMapConvertToCRS_EPSG_32755_From_4283>
    ] .

