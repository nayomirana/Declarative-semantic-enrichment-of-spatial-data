<#DVM_GeometryInstancesWB_Flood> a rr:TriplesMap;
  rml:logicalSource <#LogicalSource_WBResources_flood_auth_non_auth>;

    rr:subjectMap [
    rr:template "http://example.org/ns/DV_Project#{dataset}_{geomtype}{OBJECTID}";
    # rml:logicalTarget <#TargetSPARQL>;
    rr:class geosparql:Geometry
  ];

     rr:predicateObjectMap [
          rr:predicate geosparql:asWKT;
          rr:objectMap <#FunctionMapConvertToCRS_EPSG_4326_From_7844>
   ] .


  ########## Custom Functions to transform CRS codes ################
    <#FunctionMapConvertToCRS_EPSG_32755_From_4283> a fnml:FunctionMap ;
    fnml:functionValue [
      rr:predicateObjectMap [
        rr:predicate fno:executes ;
        rr:objectMap [ rr:constant geogrel:setGeomToCRSForGivenSourceTargetCodes ]
      ] ;

      rr:predicateObjectMap [
        rr:predicate geogrel:valueParam ;
         rr:objectMap [ rml:reference "geom" ]
      ];
      
      rr:predicateObjectMap [
        rr:predicate geogrel:valueParam2 ;
        rr:objectMap [ rr:constant "EPSG:4283" ] ]; 

     rr:predicateObjectMap [
        rr:predicate geogrel:valueParam3 ;
        rr:objectMap [ rr:constant "EPSG:32755" ] ]
    ] ;

    rr:termType rr:Literal ;
    rr:datatype geosparql:wktLiteral .

    <#FunctionMapConvertToCRS_EPSG_4326_From_4283>  a fnml:FunctionMap ;
    fnml:functionValue [
      rr:predicateObjectMap [
        rr:predicate fno:executes ;
        rr:objectMap [ rr:constant geogrel:setGeomToCRSForGivenSourceTargetCodes]
      ] ;

      rr:predicateObjectMap [
        rr:predicate geogrel:valueParam ;
        rr:objectMap [ rml:reference "geom" ]
      ];
      
      rr:predicateObjectMap [
        rr:predicate geogrel:valueParam2 ;
        rr:objectMap [ rr:constant "EPSG:4283" ] ];

     rr:predicateObjectMap [
        rr:predicate geogrel:valueParam3 ;
        rr:objectMap [ rr:constant "EPSG:4326" ] ]
    ] ;

    rr:termType rr:Literal ;
    rr:datatype geosparql:wktLiteral .

  <#FunctionMapConvertToCRS_EPSG_32755_From_7855>  a fnml:FunctionMap ;
    fnml:functionValue [
