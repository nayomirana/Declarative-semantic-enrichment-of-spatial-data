@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rrx: <http://www.w3.org/ns/r2rml-ext#>.
@prefix rrxf: <http://www.w3.org/ns/r2rml-ext/functions/def/>.
@prefix rrf: <http://kdeg.scss.tcd.ie/ns/rrf#> .
@prefix geosparql: <http://www.opengis.net/ont/geosparql#> .
@prefix rmlt: <http://semweb.mmlab.be/ns/rml-target#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix onto: <http://example.di.uoa.gr/ontology#>.
@prefix geogrel: <https://raw.githubusercontent.com/nayomirana/Declarative-semantic-enrichment-of-spatial-data/refs/heads/main/Usea%20case3/src/GeoGREL/geofunctions.ttl#> .
@prefix fno: <http://w3id.org/function/ontology#> .
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix formats: <https://www.w3.org/ns/formats/> .
@prefix d2rq: <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#> .
@prefix dynamicVicMapVocab: <http://example.org/ns/DV_Project#> .
@prefix ex: <http://example.com/functions#> .
@base <http://example.com/> .

<#SPARQLEndpoint> a sd:Service;
  sd:endpoint <http://13.211.150.184:7200/repositories/dvicmap/statements> ;
  sd:supportedLanguage sd:SPARQL11Update.

<#TargetSPARQL> a rmlt:LogicalTarget;
  rmlt:target <#SPARQLEndpoint>.

<#InputSPARQL>
    a sd:Service ;
    sd:endpoint <http://13.211.150.184:7200/repositories/dvicmap> ;
    sd:supportedLanguage sd:SPARQL11Query ;
    sd:resultFormat <http://www.w3.org/ns/formats/SPARQL_Results_JSON>; .


## Used to generate buffers for the geometries identified as primary geometries in Step 2, as well as for all points.
 <#LogicalSource_PreprocessingGeomBefWbInstance>
  rml:logicalSource [
        rml:source <#InputSPARQL>;
        rml:referenceFormulation ql:JSONPath;
        rml:iterator "$.results.bindings[*]";
        rml:query """
        PREFIX geof: <http://www.opengis.net/def/function/geosparql/>
        PREFIX geo: <http://www.opengis.net/ont/geosparql#>
        PREFIX DV_Project: <http://example.org/ns/DV_Project#>
  
        SELECT   ?geom1 ?objectid ?geometryType ?geometryCRS32755  ?dataset
	      WHERE {
          {
                # Layer 1 geometries
                ?geom1 a geo:Geometry ;
            		        DV_Project:hasObjectID ?objectid ;
            		        DV_Project:hasGeometryType ?geometryType ;
            		        DV_Project:geometryCRS32755 ?geometryCRS32755 ;
            		        DV_Project:isPrimary ?isPrimary ;
    		    	          DV_Project:dataset ?dataset ;
                        DV_Project:isPrimary true .
    
                       VALUES ?dataset {
                                    "HY_WATER_AREA_POLYGON"
                                    "HY_WATER_AREA_ML"
                                    "HY_WATER_AREA_LIDAR"
                                }
            		       
          }
        UNION
        {
                ?geom1 a geo:Geometry ;
            		        DV_Project:hasObjectID ?objectid ;
            		        DV_Project:hasGeometryType ?geometryType ;
            		        DV_Project:geometryCRS32755 ?geometryCRS32755 ;
    				            DV_Project:dataset ?dataset ;
                        DV_Project:dataset "HY_WATER_POINT" .
            
        }
      }
          """
          ].

<#PreprocessingGeomBeforeWbInstance>
    a rr:TriplesMap;
   rml:logicalSource <#LogicalSource_PreprocessingGeomBefWbInstance>;

        rr:subjectMap [
            rr:template  "http://example.org/ns/DV_Project#{dataset.value}_{geometryType.value}{objectid.value}";
           ##  rml:logicalTarget <#TargetSPARQL>
        ];
        
    rr:predicateObjectMap [
          rr:predicate dynamicVicMapVocab:hasGeometryCRS4326AfterBuffer;
          rr:objectMap <#FunctionMapConvertToCRSEPSG4326_AfterBuffer>
    ]  .
        
############################       Functions      ############################
### Convert the CRS of the buffered geometries.
<#FunctionMapConvertToCRSEPSG4326_AfterBuffer> a fnml:FunctionMap;
    fnml:functionValue [
     # rml:logicalSource <#LogicalSource> ;
      rr:predicateObjectMap [
        rr:predicate fno:executes ;
        rr:objectMap [ rr:constant geogrel:setGeomToCRSForGivenSourceTargetCodes ]
      ] ;

      rr:predicateObjectMap [
        rr:predicate geogrel:valueParam ;
        rr:objectMap <#FunctionsForPerformingBufferOperation>
      ];
      
      rr:predicateObjectMap [
        rr:predicate geogrel:valueParam2 ;
        rr:objectMap [ rr:constant "EPSG:32755" ] ];

     rr:predicateObjectMap [
        rr:predicate geogrel:valueParam3 ;
        rr:objectMap [ rr:constant "EPSG:4326" ] ]
    ] ;

    rr:termType rr:Literal ;
    rr:datatype geosparql:wktLiteral .

## Function to perform buffer for specified distance
<#FunctionsForPerformingBufferOperation> a fnml:FunctionMap;
      fnml:functionValue [
         rml:logicalSource <#LogicalSource_PreprocessingGeomBefWbInstance> ;
      	rr:predicateObjectMap [
      		rr:predicate fno:executes ;
      		rr:objectMap [ rr:constant geogrel:getBufferedGeomForGivenDist ] ] ;
      	rr:predicateObjectMap [
      		rr:predicate geogrel:valueParam ;
      	  rr:objectMap [ rml:reference "geometryCRS32755.value" ] ] ;
      	rr:predicateObjectMap [
            rr:predicate geogrel:valueParam2 ;
           rr:objectMap [ rr:constant "10" ] ]
      ];

    rr:termType rr:Literal ;
    rr:datatype geosparql:wktLiteral .
