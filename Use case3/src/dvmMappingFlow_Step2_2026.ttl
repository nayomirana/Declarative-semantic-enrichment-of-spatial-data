@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rrx: <http://www.w3.org/ns/r2rml-ext#> .
@prefix rrxf: <http://www.w3.org/ns/r2rml-ext/functions/def/> .
@prefix rrf: <http://kdeg.scss.tcd.ie/ns/rrf#> .
@prefix geosparql: <http://www.opengis.net/ont/geosparql#> .
@prefix rmlt: <http://semweb.mmlab.be/ns/rml-target#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix onto: <http://example.di.uoa.gr/ontology#>.
@prefix fno: <http://w3id.org/function/ontology#> .
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix formats: <https://www.w3.org/ns/formats/> .
@prefix d2rq: <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#> .
@prefix dynamicVicMapVocab: <http://example.org/ns/DV_Project#> .
@prefix ex: <http://example.com/functions#> .
@base <http://example.com/> .

<#SPARQLEndpoint> a sd:Service;
  sd:endpoint <http://13.211.150.184:7200/repositories/dvicmap/statements> ;
  sd:supportedLanguage sd:SPARQL11Update.


<#TargetSPARQL> a rmlt:LogicalTarget;
  rmlt:target <#SPARQLEndpoint>.

<#InputSPARQL>
    a sd:Service ;
    sd:endpoint <http://13.211.150.184:7200/repositories/dvicmap> ;
    sd:supportedLanguage sd:SPARQL11Query ;
    sd:resultFormat <http://www.w3.org/ns/formats/SPARQL_Results_JSON>; .


## Used to identify  machine-learned water body footprints that do not intersects with authoritative water body polygons
<#PrimaryGeometriesOfWBPolygonsAndMLPolygons>
    rml:logicalSource [
        rml:source <#InputSPARQL>;
        rml:referenceFormulation ql:JSONPath;
        rml:iterator "$.results.bindings[*]";
        rml:query """
        PREFIX geo: <http://www.opengis.net/ont/geosparql#>
        PREFIX geof: <http://www.opengis.net/def/function/geosparql/>
        PREFIX DV_Project: <http://example.org/ns/DV_Project#>

        SELECT ?geom2 ?objectid2 ?geometryType2
	      WHERE {
    	          # Layer 2 geometries 
    	          ?geom2 a geo:Geometry ;
    				              geo:asWKT ?geometry2;
                          DV_Project:hasObjectID ?objectid2;
                          DV_Project:hasGeometryType ?geometryType2;
                          DV_Project:dataset "HY_WATER_AREA_ML".
          
          			# Exclude intersections with Layer 1 geometries
          			          FILTER NOT EXISTS {
        				                ?geom1 a geo:Geometry ;
          				                geo:asWKT ?geometry1 ;
                                        DV_Project:dataset "HY_WATER_AREA_POLYGON".
          
          			                    # Check intersection
                                        ?geom2 geo:sfIntersects ?geom1.
                                } 
                }
       """
    ];

    rr:subjectMap [
        rr:template  "http://example.org/ns/DV_Project#HY_WATER_AREA_ML_{geometryType2.value}{objectid2.value}";
        rml:logicalTarget <#TargetSPARQL>
     ];

    rr:predicateObjectMap [
        rr:predicate dynamicVicMapVocab:isPrimary ;
        rr:objectMap [
            rr:constant "true";  
            rr:datatype <http://www.w3.org/2001/XMLSchema#boolean>;  
        ];
    ].

## Used to identify  HY_WATER_AREA_LIDAR Polygons  that do not intersects with HY_WATER_AREA_ML Polygons
<#PrimaryGeometriesOfMLPolygonsAndLidarPolygons>
    rml:logicalSource [
        rml:source <#InputSPARQL>;
        rml:referenceFormulation ql:JSONPath;
        rml:iterator "$.results.bindings[*]";
        rml:query """
        PREFIX geo: <http://www.opengis.net/ont/geosparql#>
        PREFIX geof: <http://www.opengis.net/def/function/geosparql/>
        PREFIX DV_Project: <http://example.org/ns/DV_Project#>

        SELECT ?geom4 ?objectid4 ?geometryType4
        WHERE {
              # Layer 4 geometries 
              ?geom4 a geo:Geometry ;
                        geo:asWKT ?geometry4 ;
                        DV_Project:hasObjectID ?objectid4 ;
                        DV_Project:hasGeometryType ?geometryType4;
                        DV_Project:dataset "HY_WATER_AREA_LIDAR".

                # Exclude intersections with Layer 2 geometries
    	          FILTER  NOT EXISTS {
                        ?geom2 a geo:Geometry ;
                        geo:asWKT ?geometry2;
                        DV_Project:dataset "HY_WATER_AREA_ML".
                           
                        # Check intersection
                        ?geom4 geo:sfIntersects ?geom2.
                }
          }
       """
    ];

    rr:subjectMap [
        rr:template  "http://example.org/ns/DV_Project#HY_WATER_AREA_LIDAR_{geometryType4.value}{objectid4.value}";
        rml:logicalTarget <#TargetSPARQL>
     ];

rr:predicateObjectMap [
    rr:predicate dynamicVicMapVocab:isPrimary ;
    rr:objectMap [
          rr:constant "true";  
          rr:datatype <http://www.w3.org/2001/XMLSchema#boolean>;  
    ]
].

## All HY_WATER_AREA_POLYGON Polygons are considered as primary geometries 
<#WbPolygonsAsPrimaryGeometries>
    rml:logicalSource [
        rml:source <#InputSPARQL>;
        rml:referenceFormulation ql:JSONPath;
        rml:iterator "$.results.bindings[*]";
        rml:query """
        PREFIX geo: <http://www.opengis.net/ont/geosparql#>
        PREFIX DV_Project: <http://example.org/ns/DV_Project#>

        SELECT ?geom ?objectid ?geometryType
        WHERE {
              ?geom a geo:Geometry ;
                      DV_Project:hasObjectID ?objectid ;
                      DV_Project:hasGeometryType ?geometryType;
                      DV_Project:dataset "HY_WATER_AREA_POLYGON".
                      }
       """
    ];

    rr:subjectMap [
        rr:template  "http://example.org/ns/DV_Project#HY_WATER_AREA_POLYGON_{geometryType.value}{objectid.value}";
        rml:logicalTarget <#TargetSPARQL>
     ];

rr:predicateObjectMap [
    rr:predicate dynamicVicMapVocab:isPrimary ;
    rr:objectMap [
          rr:constant "true";  
          rr:datatype <http://www.w3.org/2001/XMLSchema#boolean>;  
    ]
].
