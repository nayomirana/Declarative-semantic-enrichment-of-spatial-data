@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap:    <http://usefulinc.com/ns/doap#> .
@prefix fno:     <https://w3id.org/function/ontology#> .
@prefix fnoi:    <https://w3id.org/function/vocabulary/implementation#> .
@prefix fnom:    <https://w3id.org/function/vocabulary/mapping#> .
@prefix geogrel: <https://raw.githubusercontent.com/nayomirana/Declarative-semantic-enrichment-of-spatial-data/refs/heads/main/Usea%20case3/src/GeoGREL/geofunctions.ttl#> .
@prefix grelm:   <http://fno.io/grel/rmlmapping#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix lib: <http://example.com/library#> .
@prefix ex: <http://example.org/> .
@base <http://example.com/> .

geogrel:void
    a                 void:DatasetDescription ;
    dcterms:title     "An extension to GREL that supports functions for working with spatial datasets." ;
.

geogrel:valueParam a fno:Parameter ;
  fno:name "input value" ;
  rdfs:label "input value" ;
  fno:type xsd:string ;
  fno:predicate geogrel:valueParameter .

geogrel:valueParam2 a fno:Parameter ;
  fno:name "input value 2" ;
  rdfs:label "input value 2" ;
  fno:type xsd:string ;
  fno:predicate geogrel:valueParameter2 .


geogrel:stringOut
    a             fno:Output ;
    fno:name      "output string" ;
    rdfs:label    "output string" ;
    fno:predicate geogrel:stringOutput ;
    fno:type      xsd:string .

# ###################### Convert to CRS for given code ###############################
geogrel:setGeometryToCRSForGivenCode a fno:Function ;
  fno:name "setGeometryToCRSForGivenCode" ;
  rdfs:label "setGeometryToCRSForGivenCode" ;
  dcterms:description "setGeometryToCRSForGivenCode" ;

  fno:expects ( 
      [ a fno:Parameter ; 
        fno:name "input1" ; 
        fno:type xsd:string ;  
        fno:predicate geogrel:valueParam  
      ] 
      [ a fno:Parameter ; 
        fno:name "input2" ; 
        fno:type xsd:string ;  
        fno:predicate geogrel:valueParam2  
      ]
  ) ;

 fno:returns ( geogrel:stringOut ) .


grelm:javaString
    a                  fnoi:JavaClass ;
    doap:download-page "GeoProcessor.jar" ;
    fnoi:class-name    "GeoProcessor" .

grelm:setGeometryToCRSForGivenCode
    a                    fno:Mapping ;
    fno:function         geogrel:setGeometryToCRSForGivenCode ;
    fno:implementation   grelm:javaString ;
    fno:methodMapping    [ a                fnom:Function ;
                           fnom:method-name "setGeometryToCRSForGivenCode" ] .


########### Get formattedDate #########################################
geogrel:formatDate a fno:Function ;
  fno:name "formatDate" ;
  rdfs:label "formatDate" ;
  dcterms:description "formatDate" ;
  fno:expects ( geogrel:valueParam ) ;
  fno:returns ( geogrel:stringOut ) .

grelm:formatDate
    a                    fno:Mapping ;
    fno:function         geogrel:formatDate ;
    fno:implementation   grelm:javaString ;
    fno:methodMapping    [ a                fnom:Function ;
                           fnom:method-name "formatDate" ] .



########################### Convert to CRS for given source and target codes #################
geogrel:setGeomToCRSForGivenSourceTargetCodes a fno:Function ;
  fno:name "setGeomToCRSForGivenSourceTargetCodes" ;
  rdfs:label "setGeomToCRSForGivenSourceTargetCodes" ;
  dcterms:description "setGeomToCRSForGivenSourceTargetCodes" ;

  fno:expects ( 
      [ a fno:Parameter ; 
        fno:name "input1" ; 
        fno:type xsd:string ;  
        fno:predicate geogrel:valueParam  
      ] 
      [ a fno:Parameter ; 
        fno:name "input2" ; 
        fno:type xsd:string ;   
        fno:predicate geogrel:valueParam2  
      ]
      [ a fno:Parameter ; 
        fno:name "input3" ; 
        fno:type xsd:string ; 
        fno:predicate geogrel:valueParam3 
      ]
  ) ;

 fno:returns ( geogrel:stringOut ) .

grelm:setGeomToCRSForGivenSourceTargetCodes
    a                    fno:Mapping ;
    fno:function         geogrel:setGeomToCRSForGivenSourceTargetCodes ;
   fno:implementation   grelm:javaString ;
    fno:methodMapping    [ a                fnom:Function ;
                           fnom:method-name "setGeomToCRSForGivenSourceTargetCodes" ] .


###################### Get BBox of geometry ###############################
geogrel:getBoundingBoxOfPolygon a fno:Function ;
  fno:name "getBoundingBoxOfPolygon" ;
  rdfs:label "getBoundingBoxOfPolygon" ;
  dcterms:description "getBoundingBoxOfPolygon" ;
  fno:expects ( geogrel:valueParam ) ;
  fno:returns ( geogrel:stringOut ) .

grelm:getBoundingBoxOfPolygon
    a                    fno:Mapping ;
    fno:function         geogrel:getBoundingBoxOfPolygon ;
    fno:implementation   grelm:javaString ;
    fno:methodMapping    [ a                fnom:Function ;
                           fnom:method-name "getBoundingBoxOfPolygon" ] .

###################### Get Buffer geometry for given distance ###############################
geogrel:getBufferedGeomForGivenDist a fno:Function ;
  fno:name "getBufferedGeomForGivenDist" ;
  rdfs:label "getBufferedGeomForGivenDist" ;
  dcterms:description "getBufferedGeomForGivenDist" ;

  fno:expects ( 
      [ a fno:Parameter ; 
        fno:name "input1" ; 
        fno:type xsd:string ;  
        fno:predicate geogrel:valueParam 
      ] 
      [ a fno:Parameter ; 
        fno:name "input2" ; 
        fno:type xsd:string ;  
        fno:predicate geogrel:valueParam2  
      ]
  ) ;

 fno:returns ( geogrel:stringOut ) .

grelm:getBufferedGeomForGivenDist
    a                    fno:Mapping ;
    fno:function         geogrel:getBufferedGeomForGivenDist ;
    fno:implementation   grelm:javaString ;
    fno:methodMapping    [ a                fnom:Function ;
                           fnom:method-name "getBufferedGeomForGivenDist" ] .
