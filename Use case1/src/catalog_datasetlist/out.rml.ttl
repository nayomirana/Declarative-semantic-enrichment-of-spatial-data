@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#>.
@prefix fno: <https://w3id.org/function/ontology#>.
@prefix d2rq: <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#>.
@prefix void: <http://rdfs.org/ns/void#>.
@prefix dc: <http://purl.org/dc/terms/>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix rml: <http://semweb.mmlab.be/ns/rml#>.
@prefix ql: <http://semweb.mmlab.be/ns/ql#>.
@prefix : <http://mapping.example.com/>.
@prefix ex: <http://example.org/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix dcat: <http://www.w3.org/ns/dcat#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix idlab-fn: <http://example.com/idlab/function/>.
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#>.

:rules_000 a void:Dataset;
    void:exampleResource :map_catalog_000.
:map_catalog_000 rml:logicalSource :source_000.
:source_000 a rml:LogicalSource;
    rml:source "catalog_datasets_list.json";
    rml:iterator "$[*]";
    rml:referenceFormulation ql:JSONPath.
:map_catalog_000 a rr:TriplesMap;
    rdfs:label "catalog".
:s_000 a rr:SubjectMap.
:map_catalog_000 rr:subjectMap :s_000.
:s_000 rr:template "http://wwww.example.com/catalog/datasets/{title}".
:pom_000 a rr:PredicateObjectMap.
:map_catalog_000 rr:predicateObjectMap :pom_000.
:pm_000 a rr:PredicateMap.
:pom_000 rr:predicateMap :pm_000.
:pm_000 rr:constant rdf:type.
:pom_000 rr:objectMap :om_000.
:om_000 a rr:ObjectMap;
    rr:constant dcat:Dataset;
    rr:termType rr:IRI.
:pom_001 a rr:PredicateObjectMap.
:map_catalog_000 rr:predicateObjectMap :pom_001.
:pm_001 a rr:PredicateMap.
:pom_001 rr:predicateMap :pm_001.
:pm_001 rr:constant dcterms:title.
:pom_001 rr:objectMap :om_001.
:om_001 a rr:ObjectMap;
    rml:reference "title";
    rr:termType rr:Literal.
:pom_002 a rr:PredicateObjectMap.
:map_catalog_000 rr:predicateObjectMap :pom_002.
:pm_002 a rr:PredicateMap.
:pom_002 rr:predicateMap :pm_002.
:pm_002 rr:constant dcterms:description.
:pom_002 rr:objectMap :om_002.
:om_002 a rr:ObjectMap;
    rr:template "{description})";
    rr:termType rr:Literal;
    rml:languageMap :language_000.
:language_000 rr:constant "en".
:pom_003 a rr:PredicateObjectMap.
:map_catalog_000 rr:predicateObjectMap :pom_003.
:pm_003 a rr:PredicateMap.
:pom_003 rr:predicateMap :pm_003.
:pm_003 rr:constant dcterms:identifier.
:pom_003 rr:objectMap :om_003.
:om_003 a rr:ObjectMap;
    rml:reference "identifier";
    rr:termType rr:Literal.
:pom_004 a rr:PredicateObjectMap.
:map_catalog_000 rr:predicateObjectMap :pom_004.
:pm_004 a rr:PredicateMap.
:pom_004 rr:predicateMap :pm_004.
:pm_004 rr:constant dcterms:issued.
:pom_004 rr:objectMap :om_004.
:om_004 a rr:ObjectMap;
    rml:reference "issued";
    rr:termType rr:Literal;
    rr:datatype xsd:dateTime.
:pom_005 a rr:PredicateObjectMap.
:map_catalog_000 rr:predicateObjectMap :pom_005.
:pm_005 a rr:PredicateMap.
:pom_005 rr:predicateMap :pm_005.
:pm_005 rr:constant dcterms:modified.
:pom_005 rr:objectMap :om_005.
:om_005 a rr:ObjectMap;
    rml:reference "modified";
    rr:termType rr:Literal;
    rr:datatype xsd:dateTime.
:pom_006 a rr:PredicateObjectMap.
:map_catalog_000 rr:predicateObjectMap :pom_006.
:pm_006 a rr:PredicateMap.
:pom_006 rr:predicateMap :pm_006.
:pm_006 rr:constant dcat:landingPage.
:pom_006 rr:objectMap :om_006.
:om_006 a rr:ObjectMap;
    rml:reference "landingPage";
    rr:termType rr:IRI.
:pom_007 a rr:PredicateObjectMap.
:map_catalog_000 rr:predicateObjectMap :pom_007.
:pm_007 a rr:PredicateMap.
:pom_007 rr:predicateMap :pm_007.
:pm_007 rr:constant dcterms:publisher.
:pom_008 a rr:PredicateObjectMap.
:map_catalog_000 rr:predicateObjectMap :pom_008.
:pm_008 a rr:PredicateMap.
:pom_008 rr:predicateMap :pm_008.
:pm_008 rr:constant dcat:keyword.
:pom_008 rr:objectMap :om_007.
:om_007 a rr:ObjectMap;
    rml:reference "keyword[*]";
    rr:termType rr:Literal.
:pom_009 a rr:PredicateObjectMap.
:map_catalog_000 rr:predicateObjectMap :pom_009.
:pm_009 a rr:PredicateMap.
:pom_009 rr:predicateMap :pm_009.
:pm_009 rr:constant dcterms:language.
:pom_009 rr:objectMap :om_008.
:om_008 a rr:ObjectMap;
    rr:template "http://id.loc.gov/vocabulary/iso639-1/{language[*]}";
    rr:termType rr:IRI.
:pom_010 a rr:PredicateObjectMap.
:map_catalog_000 rr:predicateObjectMap :pom_010.
:pm_010 a rr:PredicateMap.
:pom_010 rr:predicateMap :pm_010.
:pm_010 rr:constant dcat:distribution.
:pom_010 rr:objectMap :om_009.
:om_009 a rr:ObjectMap;
    rr:template "http://wwww.example.com/distribution/{distribution[*].title}";
    rr:termType rr:IRI.
:rules_000 void:exampleResource :map_publisherMapping_000.
:map_publisherMapping_000 rml:logicalSource :source_001.
:source_001 a rml:LogicalSource;
    rml:source "catalog_datasets_list.json";
    rml:iterator "$.[*].publisher";
    rml:referenceFormulation ql:JSONPath.
:map_publisherMapping_000 a rr:TriplesMap;
    rdfs:label "publisherMapping".
:s_001 a rr:SubjectMap.
:map_publisherMapping_000 rr:subjectMap :s_001.
:s_001 rr:termType rr:BlankNode.
:pom_011 a rr:PredicateObjectMap.
:map_publisherMapping_000 rr:predicateObjectMap :pom_011.
:pm_011 a rr:PredicateMap.
:pom_011 rr:predicateMap :pm_011.
:pm_011 rr:constant rdf:type.
:pom_011 rr:objectMap :om_010.
:om_010 a rr:ObjectMap;
    rr:constant foaf:Agent;
    rr:termType rr:IRI.
:pom_012 a rr:PredicateObjectMap.
:map_publisherMapping_000 rr:predicateObjectMap :pom_012.
:pm_012 a rr:PredicateMap.
:pom_012 rr:predicateMap :pm_012.
:pm_012 rr:constant foaf:name.
:pom_012 rr:objectMap :om_011.
:om_011 a rr:ObjectMap;
    rml:reference "name";
    rr:termType rr:Literal.
:pom_013 a rr:PredicateObjectMap.
:map_publisherMapping_000 rr:predicateObjectMap :pom_013.
:pm_013 a rr:PredicateMap.
:pom_013 rr:predicateMap :pm_013.
:pm_013 rr:constant foaf:mbox.
:pom_013 rr:objectMap :om_012.
:om_012 a rr:ObjectMap;
    rml:reference "mbox";
    rr:termType rr:Literal.
:rules_000 void:exampleResource :map_distributionMapping_000.
:map_distributionMapping_000 rml:logicalSource :source_002.
:source_002 a rml:LogicalSource;
    rml:source "catalog_datasets_list.json";
    rml:iterator "$.[*].distribution[*]";
    rml:referenceFormulation ql:JSONPath.
:map_distributionMapping_000 a rr:TriplesMap;
    rdfs:label "distributionMapping".
:s_002 a rr:SubjectMap.
:map_distributionMapping_000 rr:subjectMap :s_002.
:s_002 rr:template "http://wwww.example.com/distribution/{title}".
:pom_014 a rr:PredicateObjectMap.
:map_distributionMapping_000 rr:predicateObjectMap :pom_014.
:pm_014 a rr:PredicateMap.
:pom_014 rr:predicateMap :pm_014.
:pm_014 rr:constant rdf:type.
:pom_014 rr:objectMap :om_013.
:om_013 a rr:ObjectMap;
    rr:constant dcat:Distribution;
    rr:termType rr:IRI.
:pom_015 a rr:PredicateObjectMap.
:map_distributionMapping_000 rr:predicateObjectMap :pom_015.
:pm_015 a rr:PredicateMap.
:pom_015 rr:predicateMap :pm_015.
:pm_015 rr:constant dcat:accessURL.
:pom_015 rr:objectMap :om_014.
:om_014 a rr:ObjectMap;
    rml:reference "accessURL";
    rr:termType rr:IRI.
:pom_016 a rr:PredicateObjectMap.
:map_distributionMapping_000 rr:predicateObjectMap :pom_016.
:pm_016 a rr:PredicateMap.
:pom_016 rr:predicateMap :pm_016.
:pm_016 rr:constant dcat:byteSize.
:pom_016 rr:objectMap :om_015.
:om_015 a rr:ObjectMap;
    rml:reference "byteSize";
    rr:termType rr:Literal.
:pom_017 a rr:PredicateObjectMap.
:map_distributionMapping_000 rr:predicateObjectMap :pom_017.
:pm_017 a rr:PredicateMap.
:pom_017 rr:predicateMap :pm_017.
:pm_017 rr:constant dcterms:description.
:pom_017 rr:objectMap :om_016.
:om_016 a rr:ObjectMap;
    rr:template "{description})";
    rr:termType rr:Literal;
    rml:languageMap :language_001.
:language_001 rr:constant "en".
:pom_018 a rr:PredicateObjectMap.
:map_distributionMapping_000 rr:predicateObjectMap :pom_018.
:pm_018 a rr:PredicateMap.
:pom_018 rr:predicateMap :pm_018.
:pm_018 rr:constant dcat:downloadURL.
:pom_018 rr:objectMap :om_017.
:om_017 a rr:ObjectMap;
    rml:reference "downloadURL";
    rr:termType rr:IRI.
:pom_019 a rr:PredicateObjectMap.
:map_distributionMapping_000 rr:predicateObjectMap :pom_019.
:pm_019 a rr:PredicateMap.
:pom_019 rr:predicateMap :pm_019.
:pm_019 rr:constant dcterms:format.
:pom_019 rr:objectMap :om_018.
:om_018 a rr:ObjectMap;
    rml:reference "format";
    rr:termType rr:Literal.
:pom_020 a rr:PredicateObjectMap.
:map_distributionMapping_000 rr:predicateObjectMap :pom_020.
:pm_020 a rr:PredicateMap.
:pom_020 rr:predicateMap :pm_020.
:pm_020 rr:constant dcterms:issued.
:pom_020 rr:objectMap :om_019.
:om_019 a rr:ObjectMap;
    rml:reference "issued";
    rr:termType rr:Literal;
    rr:datatype xsd:date.
:pom_021 a rr:PredicateObjectMap.
:map_distributionMapping_000 rr:predicateObjectMap :pom_021.
:pm_021 a rr:PredicateMap.
:pom_021 rr:predicateMap :pm_021.
:pm_021 rr:constant dcterms:license.
:pom_021 rr:objectMap :om_020.
:om_020 a rr:ObjectMap;
    rml:reference "license";
    rr:termType rr:Literal.
:pom_022 a rr:PredicateObjectMap.
:map_distributionMapping_000 rr:predicateObjectMap :pom_022.
:pm_022 a rr:PredicateMap.
:pom_022 rr:predicateMap :pm_022.
:pm_022 rr:constant dcterms:modified.
:pom_022 rr:objectMap :om_021.
:om_021 a rr:ObjectMap;
    rml:reference "modified";
    rr:termType rr:Literal;
    rr:datatype xsd:date.
:pom_023 a rr:PredicateObjectMap.
:map_distributionMapping_000 rr:predicateObjectMap :pom_023.
:pm_023 a rr:PredicateMap.
:pom_023 rr:predicateMap :pm_023.
:pm_023 rr:constant dcterms:title.
:pom_023 rr:objectMap :om_022.
:om_022 a rr:ObjectMap;
    rml:reference "title";
    rr:termType rr:Literal.
:pom_007 rr:objectMap :om_023.
:om_023 a rr:ObjectMap;
    rr:parentTriplesMap :map_publisherMapping_000;
    rr:joinCondition :jc_000.
:jc_000 rr:child "publisher.name";
    rr:parent "name".
