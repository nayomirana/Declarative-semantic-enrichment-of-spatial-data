:pom_009 rr:objectMap :om_021.
:om_021 a rr:ObjectMap;
    rr:parentTriplesMap :map_publisher_000.
:pom_010 rr:objectMap :om_022.
:om_022 a rr:ObjectMap;
    rr:parentTriplesMap :map_creator_000.
:pom_011 rr:objectMap :om_023.
:om_023 a rr:ObjectMap;
    rr:parentTriplesMap :map_distribution_000.
